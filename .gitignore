# Gradle / build
.gradle/
build/
out/
bin/
mcmodsrepo/

# Dev run directories. Per-version and kept at the repository root, so run-*/ covers every version
# but the reference one -- see gemrender-internal/docs/MULTIVERSION.md.
run/
run-data/
run-*/

# Stonecutter version subprojects: their gradle.properties IS the configuration and is tracked;
# everything else in them is generated. build/ above already covers versions/<v>/build, but the
# legacy-Forge toolchain also drops a log directory beside it.
versions/*/logs/

# Generated data
src/generated/resources/.cache/

# Third-party vehicle assets, if a local checkout ever puts them here rather than in the second
# resource root. They are never ours to redistribute.
src/main/resources/assets/gemrender/models/vehicles/

# RenderDoc captures are large and machine-specific.
*.rdc
*.cap

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/
.eclipse/
.settings/
.classpath
.project
